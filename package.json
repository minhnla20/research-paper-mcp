{
  "name": "research-paper-mcp",
  "version": "1.0.0",
  "description": "MCP server for intelligent research paper discovery and management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "cf deploy --mode staging",
    "deploy:production": "cf deploy --mode production",
    "worker:dev": "cf dev",
    "worker:build": "tsc && cf deploy",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@lmstudio/sdk": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "notion-client": "^2.2.0",
    "pdf-lib": "^1.17.0",
    "rate-limiter-flexible": "^5.0.0",
    "webdav": "^5.6.0",
    "xml2js": "^0.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@types/node": "^20.0.0",
    "@types/xml2js": "^0.4.0",
    "cf": "1.0.0-beta.11",
    "tsx": "^4.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@10.33.0"
}
